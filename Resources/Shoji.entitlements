<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release builds run with the hardened runtime (needed for notarization), which blocks
	     Apple Events unless allowed here: Shoji asks System Events to switch Dark/Light mode
	     to match the theme (macOS still asks the user once; NSAppleEventsUsageDescription). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
